TELEGRAM_TOKEN=your_telegram_bot_token_here

# Whisper model size: tiny | base | small | medium | large-v3
# tiny   ~40 MB RAM  — fastest, lower quality
# base   ~75 MB RAM  — fast, decent quality
# small  ~250 MB RAM — good balance (recommended)
# medium ~500 MB RAM — great quality, needs 4 GB RAM
WHISPER_MODEL=small
