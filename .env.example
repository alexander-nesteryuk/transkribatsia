TELEGRAM_TOKEN=your_telegram_bot_token_here

# Whisper model size: tiny | base | small | medium | large-v3
# tiny   ~1 GB RAM  — fastest, lower quality
# base   ~1 GB RAM  — fast, decent quality
# small  ~2 GB RAM  — good balance (recommended)
# medium ~4 GB RAM  — great quality
WHISPER_MODEL=small

# Max simultaneous transcriptions (set equal to CPU core count)
MAX_CONCURRENT=4
